type: update
id: configure-ai-models
name: Configure AI Models
description: Register OpenAI, OpenRouter, Anthropic, Gemini, and Grok providers via onboard.

baseUrl: https://raw.githubusercontent.com/sych74/openclaw/main

targetNodes:
  nodeGroup: cp

buttons:
  - name: configure
    caption: Configure
    settings: main
    confirmText: Apply provider configuration?
    loadingText: Configuring AI models...
    action: configure

settings:
  submitUnchanged: true
  fields:
    - type: displayfield
      name: currentModels
      hideLabel: true
      cls: info
      markup: Loading current model configuration...
    - type: displayfield
      name: apiKeyHint
      hideLabel: true
      cls: warning
      markup: Select a provider and enter an API key.
    - caption: Provider
      type: list
      name: provider
      default: openai
      required: true
      values:
        - value: openai
          caption: OpenAI
        - value: openrouter
          caption: OpenRouter
        - value: anthropic
          caption: Anthropic
        - value: gemini
          caption: Gemini (Google)
        - value: grok
          caption: Grok (xAI)
    - type: string
      name: apiKey
      caption: API Key
      default: ""
    - caption: None
      inputType: hidden
      hidden: true
      type: list
      name: onboardAuthChoice
      dependsOn:
        provider:
          openai:
            - value: openai-api-key
          openrouter:
            - value: openrouter-api-key
          anthropic:
            - value: apiKey
          gemini:
            - value: gemini-api-key
          grok:
            - value: xai-api-key
    - caption: None
      inputType: hidden
      hidden: true
      type: list
      name: envVarName
      dependsOn:
        provider:
          openai:
            - value: OPENAI_API_KEY
          openrouter:
            - value: OPENROUTER_API_KEY
          anthropic:
            - value: ANTHROPIC_API_KEY
          gemini:
            - value: GEMINI_API_KEY
          grok:
            - value: XAI_API_KEY

actions:
  configure:
    - cmd[cp]: |-
        set -eu

        ENV_FILE="/root/openclaw.env"

        PROVIDER="${settings.provider}"
        FORM_KEY="${settings.apiKey}"
        ONBOARD_AUTH="${settings.onboardAuthChoice}"
        ENV_VAR="${settings.envVarName}"

        API_KEY="$(printenv "$ENV_VAR" 2>/dev/null | tr -d '\r\n' || true)"
        if [ "$ENV_VAR" = "GEMINI_API_KEY" ] && [ -z "$API_KEY" ]; then
          API_KEY="$(printenv GOOGLE_API_KEY 2>/dev/null | tr -d '\r\n' || true)"
        fi
        [ -n "$FORM_KEY" ] && API_KEY="$(printf '%s' "$FORM_KEY" | tr -d '\r\n')"

        case "$PROVIDER" in
          openai) PROVIDER_ID="openai" ;;
          openrouter) PROVIDER_ID="openrouter" ;;
          anthropic) PROVIDER_ID="anthropic" ;;
          gemini) PROVIDER_ID="google" ;;
          grok) PROVIDER_ID="xai" ;;
          *)
            echo "Unknown provider: $PROVIDER"
            exit 1
            ;;
        esac

        normalize_env_value() {
          printf '%s' "$1" | tr -d '\r\n' | sed 's/^"//; s/"$//'
        }

        set_env_var() {
          key="$1"
          value="$(normalize_env_value "$2")"
          tmp="$(mktemp)"
          if [ -f "$ENV_FILE" ]; then
            grep -v "^$key=" "$ENV_FILE" > "$tmp" || true
          fi
          printf '%s=%s\n' "$key" "$value" >> "$tmp"
          mv -f "$tmp" "$ENV_FILE"
          chmod 600 "$ENV_FILE"
        }

        strip_onboard_vars() {
          tmp="$(mktemp)"
          grep -v '^ONBOARD_AUTH_CHOICE=' "$ENV_FILE" > "$tmp" || true
          mv -f "$tmp" "$ENV_FILE"
          chmod 600 "$ENV_FILE"
        }

        normalize_env_file() {
          tmp="$(mktemp)"
          while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
              ''|ONBOARD_AUTH_CHOICE=*|\#*) continue ;;
              *=*)
                key="${line%%=*}"
                value="${line#*=}"
                value="$(normalize_env_value "$value")"
                printf '%s=%s\n' "$key" "$value" >> "$tmp"
                ;;
            esac
          done < "$ENV_FILE"
          mv -f "$tmp" "$ENV_FILE"
          chmod 600 "$ENV_FILE"
        }

        read_container_port() {
          CONTAINER_PORT="18789"
          if [ ! -f "$ENV_FILE" ]; then
            return 0
          fi
          line="$(grep '^OPENCLAW_GATEWAY_PORT=' "$ENV_FILE" | tail -1 || true)"
          if [ -z "$line" ]; then
            return 0
          fi
          value="$(printf '%s' "$line" | sed 's/^OPENCLAW_GATEWAY_PORT=//')"
          value="$(printf '%s' "$value" | sed 's/^"//; s/"$//')"
          CONTAINER_PORT="$value"
        }

        if ! docker inspect openclaw >/dev/null 2>&1; then
          echo "OpenClaw container was not found."
          exit 1
        fi

        OPENCLAW_MOUNT="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/home/node/.openclaw"}}{{.Source}}{{end}}{{end}}' openclaw)"
        OPENCLAW_IMAGE="$(docker inspect -f '{{.Config.Image}}' openclaw)"
        read_container_port
        PUBLIC_PORT="$(docker port openclaw "$CONTAINER_PORT/tcp" 2>/dev/null | head -1 | cut -d: -f2 || true)"
        if [ -z "$PUBLIC_PORT" ]; then
          PUBLIC_PORT="80"
        fi

        if [ -z "$OPENCLAW_MOUNT" ]; then
          echo "Could not detect OpenClaw data mount."
          exit 1
        fi

        if [ -z "$API_KEY" ]; then
          echo "Provide an API key in the form or as platform environment variable $ENV_VAR on this node."
          exit 1
        fi

        ONBOARD_SCRIPT="$(mktemp /tmp/openclaw-onboard.XXXXXX.sh)"
        cat > "$ONBOARD_SCRIPT" << 'OC_ONBOARD'
        #!/bin/sh
        set -eu
        export OPENCLAW_CONFIG_DIR=/home/node/.openclaw
        export OPENCLAW_WORKSPACE_DIR=/home/node/.openclaw/workspace
        mkdir -p /home/node/.openclaw/workspace /home/node/.openclaw/devices
        if ! command -v openclaw >/dev/null 2>&1; then
          npm install -g openclaw@latest
        fi
        openclaw onboard --non-interactive --accept-risk \
          --mode local \
          --auth-choice "$ONBOARD_AUTH_CHOICE" \
          --secret-input-mode ref \
          --gateway-port "$OPENCLAW_GATEWAY_PORT" \
          --gateway-bind lan \
          --skip-bootstrap \
          --skip-skills \
          --skip-health
        OC_ONBOARD
        chmod 700 "$ONBOARD_SCRIPT"

        run_onboard() {
          onboard_choice="$1"
          docker run --rm \
            -u root \
            -v "$OPENCLAW_MOUNT:/home/node/.openclaw" \
            -v "$ONBOARD_SCRIPT:/tmp/openclaw-onboard.sh:ro" \
            --env-file "$ENV_FILE" \
            -e "ONBOARD_AUTH_CHOICE=$onboard_choice" \
            "$OPENCLAW_IMAGE" \
            sh /tmp/openclaw-onboard.sh
        }

        recreate_openclaw_container() {
          docker rm -f openclaw
          docker run -d \
            --name openclaw \
            --restart unless-stopped \
            -u root \
            -p "$PUBLIC_PORT:$CONTAINER_PORT" \
            -v "$OPENCLAW_MOUNT:/home/node/.openclaw" \
            --env-file "$ENV_FILE" \
            "$OPENCLAW_IMAGE" \
            sh "/home/node/.openclaw/start.sh"
        }

        docker stop openclaw

        provider_registered() {
          auth_file="$OPENCLAW_MOUNT/agents/main/agent/auth-profiles.json"
          if [ ! -f "$auth_file" ]; then
            return 1
          fi
          grep -q "\"${PROVIDER_ID}:default\"" "$auth_file" 2>/dev/null
        }

        set_env_var "$ENV_VAR" "$API_KEY"

        should_onboard=0
        if [ -n "$FORM_KEY" ]; then
          should_onboard=1
        elif ! provider_registered; then
          should_onboard=1
        fi

        if [ "$should_onboard" = 1 ]; then
          echo "Running onboard for $PROVIDER ($ONBOARD_AUTH)..."
          run_onboard "$ONBOARD_AUTH"
        else
          echo "Provider $PROVIDER already registered; syncing env only."
        fi

        strip_onboard_vars
        normalize_env_file
        recreate_openclaw_container

        for i in $(seq 1 120); do
          if curl -fsS "http://127.0.0.1:$PUBLIC_PORT/" >/dev/null 2>&1; then
            break
          fi
          sleep 2
        done

        docker exec openclaw sh -lc 'openclaw models status' || true

        rm -f "$ONBOARD_SCRIPT"
