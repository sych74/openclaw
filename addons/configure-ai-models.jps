type: update
id: configure-ai-models
name: Configure AI Models
description: Register OpenAI, OpenRouter, Anthropic, Gemini, and Grok providers via onboard and set the agent default model.
baseUrl: https://raw.githubusercontent.com/sych74/openclaw/main

targetNodes:
  nodeGroup: cp

responses:
  200:
    type: success
    message: Default model configured successfully.
  97:
    type: warning
    message: Provide an API key in the form or as a platform environment variable on this node.
  98:
    type: warning
    message: API key was rejected by the provider (invalid or revoked).
  99:
    type: warning
    message: Configuration failed. OpenClaw gateway was not changed.

buttons:
  - name: configure
    caption: Configure
    settings: configure
    confirmText: Apply provider configuration?
    loadingText: Configuring AI models...
    action: configure

settings:
  configure:
    submitUnchanged: true
    fields:
      - type: displayfield
        name: currentModels
        hideLabel: true
        cls: info
        markup: Loading current model configuration...
      - type: displayfield
        name: apiKeyHint
        hideLabel: true
        cls: warning
        markup: Select a provider, choose a model, and enter an API key.
      - caption: Provider
        type: list
        name: provider
        default: openai
        required: true
        values:
          - value: openai
            caption: OpenAI
          - value: openrouter
            caption: OpenRouter
          - value: anthropic
            caption: Anthropic
          - value: gemini
            caption: Gemini (Google)
          - value: grok
            caption: Grok (xAI)
      - caption: Model
        type: list
        name: model
        required: true
        values: []
      - type: string
        name: apiKey
        caption: API Key
        default: ""
    onBeforeInit: /scripts/configureModelsOnBeforeInit.js

actions:
  configure:
    - cmd[cp]: |-
        RESULT_FILE="/tmp/openclaw-configure.result"
        echo 99 > "$RESULT_FILE"

        (
        set -eu

        oc_finish() {
          echo "$1" > "$RESULT_FILE"
          exit "$1"
        }

        ENV_FILE="/root/openclaw.env"

        PROVIDER="${settings.provider}"
        FORM_KEY="${settings.apiKey}"

        case "$PROVIDER" in
          openai)
            PROVIDER_ID="openai"
            ENV_VAR="OPENAI_API_KEY"
            ONBOARD_AUTH="openai-api-key"
            ;;
          openrouter)
            PROVIDER_ID="openrouter"
            ENV_VAR="OPENROUTER_API_KEY"
            ONBOARD_AUTH="openrouter-api-key"
            ;;
          anthropic)
            PROVIDER_ID="anthropic"
            ENV_VAR="ANTHROPIC_API_KEY"
            ONBOARD_AUTH="apiKey"
            ;;
          gemini)
            PROVIDER_ID="google"
            ENV_VAR="GEMINI_API_KEY"
            ONBOARD_AUTH="gemini-api-key"
            ;;
          grok)
            PROVIDER_ID="xai"
            ENV_VAR="XAI_API_KEY"
            ONBOARD_AUTH="xai-api-key"
            ;;
          *)
            echo "Unknown provider: $PROVIDER"
            oc_finish 99
            ;;
        esac

        TARGET_MODEL="${settings.model}"

        if [ -z "$TARGET_MODEL" ]; then
          echo "Select a model for provider $PROVIDER."
          oc_finish 99
        fi

        API_KEY="$(printenv "$ENV_VAR" 2>/dev/null | tr -d '\r\n' || true)"
        if [ "$ENV_VAR" = "GEMINI_API_KEY" ] && [ -z "$API_KEY" ]; then
          API_KEY="$(printenv GOOGLE_API_KEY 2>/dev/null | tr -d '\r\n' || true)"
        fi
        [ -n "$FORM_KEY" ] && API_KEY="$(printf '%s' "$FORM_KEY" | tr -d '\r\n')"

        normalize_env_value() {
          printf '%s' "$1" | tr -d '\r\n' | sed 's/^"//; s/"$//'
        }

        set_env_var() {
          key="$1"
          value="$(normalize_env_value "$2")"
          tmp="$(mktemp)"
          if [ -f "$ENV_FILE" ]; then
            grep -v "^$key=" "$ENV_FILE" > "$tmp" || true
          fi
          printf '%s=%s\n' "$key" "$value" >> "$tmp"
          mv -f "$tmp" "$ENV_FILE"
          chmod 600 "$ENV_FILE"
        }

        strip_onboard_vars() {
          tmp="$(mktemp)"
          grep -v '^ONBOARD_AUTH_CHOICE=' "$ENV_FILE" > "$tmp" || true
          mv -f "$tmp" "$ENV_FILE"
          chmod 600 "$ENV_FILE"
        }

        normalize_env_file() {
          tmp="$(mktemp)"
          while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
              ''|ONBOARD_AUTH_CHOICE=*|\#*) continue ;;
              *=*)
                key="${line%%=*}"
                value="${line#*=}"
                value="$(normalize_env_value "$value")"
                printf '%s=%s\n' "$key" "$value" >> "$tmp"
                ;;
            esac
          done < "$ENV_FILE"
          mv -f "$tmp" "$ENV_FILE"
          chmod 600 "$ENV_FILE"
        }

        read_container_port() {
          CONTAINER_PORT="18789"
          if [ ! -f "$ENV_FILE" ]; then
            return 0
          fi
          line="$(grep '^OPENCLAW_GATEWAY_PORT=' "$ENV_FILE" | tail -1 || true)"
          if [ -z "$line" ]; then
            return 0
          fi
          value="$(printf '%s' "$line" | sed 's/^OPENCLAW_GATEWAY_PORT=//')"
          value="$(printf '%s' "$value" | sed 's/^"//; s/"$//')"
          CONTAINER_PORT="$value"
        }

        if ! docker inspect openclaw >/dev/null 2>&1; then
          echo "OpenClaw container was not found."
          oc_finish 99
        fi

        OPENCLAW_MOUNT="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/home/node/.openclaw"}}{{.Source}}{{end}}{{end}}' openclaw)"
        OPENCLAW_IMAGE="$(docker inspect -f '{{.Config.Image}}' openclaw)"
        read_container_port
        PUBLIC_PORT="$(docker port openclaw "$CONTAINER_PORT/tcp" 2>/dev/null | head -1 | cut -d: -f2 || true)"
        if [ -z "$PUBLIC_PORT" ]; then
          PUBLIC_PORT="80"
        fi

        if [ -z "$OPENCLAW_MOUNT" ]; then
          echo "Could not detect OpenClaw data mount."
          oc_finish 99
        fi

        if [ -z "$API_KEY" ] && [ -f "$ENV_FILE" ]; then
          env_line="$(grep "^${ENV_VAR}=" "$ENV_FILE" | tail -1 || true)"
          if [ -n "$env_line" ]; then
            API_KEY="$(normalize_env_value "${env_line#*=}")"
          fi
        fi
        if [ "$ENV_VAR" = "GEMINI_API_KEY" ] && [ -z "$API_KEY" ] && [ -f "$ENV_FILE" ]; then
          env_line="$(grep '^GOOGLE_API_KEY=' "$ENV_FILE" | tail -1 || true)"
          if [ -n "$env_line" ]; then
            API_KEY="$(normalize_env_value "${env_line#*=}")"
          fi
        fi

        if [ -z "$API_KEY" ]; then
          echo "Provide an API key in the form or as platform environment variable $ENV_VAR on this node."
          oc_finish 97
        fi

        validate_api_key() {
          case "$PROVIDER_ID" in
            openai)
              curl -fsS -o /dev/null -H "Authorization: Bearer $API_KEY" \
                "https://api.openai.com/v1/models?limit=1"
              ;;
            anthropic)
              curl -fsS -o /dev/null \
                -H "x-api-key: $API_KEY" \
                -H "anthropic-version: 2023-06-01" \
                "https://api.anthropic.com/v1/models"
              ;;
            google)
              curl -fsS -o /dev/null \
                "https://generativelanguage.googleapis.com/v1/models?key=${API_KEY}&pageSize=1"
              ;;
            openrouter)
              curl -fsS -o /dev/null -H "Authorization: Bearer $API_KEY" \
                "https://openrouter.ai/api/v1/models"
              ;;
            xai)
              curl -fsS -o /dev/null -H "Authorization: Bearer $API_KEY" \
                "https://api.x.ai/v1/models"
              ;;
            *)
              return 1
              ;;
          esac
        }

        if ! validate_api_key; then
          echo "API key was rejected by the $PROVIDER provider (invalid or revoked)."
          oc_finish 98
        fi

        MAINT_SCRIPT="$(mktemp /tmp/openclaw-maint.XXXXXX.sh)"
        cat > "$MAINT_SCRIPT" << 'OC_MAINT'
        #!/bin/sh
        set -eu
        export HOME=/home/node
        export OPENCLAW_CONFIG_DIR=/home/node/.openclaw
        export OPENCLAW_WORKSPACE_DIR=/home/node/.openclaw/workspace
        mkdir -p /home/node/.openclaw/workspace /home/node/.openclaw/devices
        if ! command -v openclaw >/dev/null 2>&1; then
          npm install -g openclaw@latest
        fi

        restore_virtuozzo_gateway() {
          openclaw config set gateway.mode local
          openclaw config set gateway.bind lan
          openclaw config set gateway.auth.mode token
          openclaw config set gateway.auth.token "$OPENCLAW_GATEWAY_TOKEN"
          openclaw config set gateway.controlUi.dangerouslyAllowHostHeaderOriginFallback true
          openclaw config set gateway.trustedProxies '["127.0.0.1"]'
          if [ -n "$OPENCLAW_GATEWAY_PASSWORD" ]; then
            openclaw config set gateway.auth.password "$OPENCLAW_GATEWAY_PASSWORD" || true
          fi
        }

        sync_auth_profile_env_ref() {
          node <<'NODE'
        const fs = require("fs");
        const authPath = "/home/node/.openclaw/agents/main/agent/auth-profiles.json";
        const profileKey = process.env.AUTH_PROFILE_KEY || "";
        const envVar = process.env.AUTH_ENV_VAR || "";
        if (!profileKey || !envVar) process.exit(0);

        let data;
        try {
          data = JSON.parse(fs.readFileSync(authPath, "utf8"));
        } catch {
          process.exit(0);
        }

        const profiles = data.profiles || data;
        const profile = profiles[profileKey];
        if (!profile) process.exit(0);

        const envRef = { source: "env", provider: "default", id: envVar };
        let changed = false;

        if (typeof profile.apiKey === "string") {
          profile.apiKey = envRef;
          changed = true;
        } else if (profile.apiKey && typeof profile.apiKey === "object") {
          if (profile.apiKey.source !== "env" || profile.apiKey.id !== envVar) {
            profile.apiKey = envRef;
            changed = true;
          }
        }

        if (changed) {
          fs.writeFileSync(authPath, JSON.stringify(data, null, 2) + "\n");
          console.log("Updated auth profile to env ref for " + profileKey);
        }
        NODE
        }

        if [ "$RUN_ONBOARD" = "1" ]; then
          openclaw onboard --non-interactive --accept-risk \
            --mode local \
            --auth-choice "$ONBOARD_AUTH_CHOICE" \
            --secret-input-mode ref \
            --gateway-port "$OPENCLAW_GATEWAY_PORT" \
            --gateway-bind lan \
            --skip-bootstrap \
            --skip-skills \
            --skip-health
        else
          sync_auth_profile_env_ref
        fi

        echo "Setting default model to $TARGET_MODEL..."
        openclaw models set "$TARGET_MODEL"
        restore_virtuozzo_gateway
        OC_MAINT
        chmod 700 "$MAINT_SCRIPT"

        run_maintenance() {
          onboard_choice="$1"
          run_onboard_flag="$2"
          docker run --rm \
            -u root \
            -e HOME=/home/node \
            -v "$OPENCLAW_MOUNT:/home/node/.openclaw" \
            -v "$MAINT_SCRIPT:/tmp/openclaw-maint.sh:ro" \
            --env-file "$ENV_FILE" \
            -e "ONBOARD_AUTH_CHOICE=$onboard_choice" \
            -e "RUN_ONBOARD=$run_onboard_flag" \
            -e "TARGET_MODEL=$TARGET_MODEL" \
            -e "AUTH_PROFILE_KEY=${PROVIDER_ID}:default" \
            -e "AUTH_ENV_VAR=$ENV_VAR" \
            "$OPENCLAW_IMAGE" \
            sh /tmp/openclaw-maint.sh
        }

        recreate_openclaw_container() {
          docker rm -f openclaw
          docker run -d \
            --name openclaw \
            --restart unless-stopped \
            -u root \
            -p "$PUBLIC_PORT:$CONTAINER_PORT" \
            -v "$OPENCLAW_MOUNT:/home/node/.openclaw" \
            --env-file "$ENV_FILE" \
            "$OPENCLAW_IMAGE" \
            sh "/home/node/.openclaw/start.sh"
        }

        docker stop openclaw

        provider_registered() {
          auth_file="$OPENCLAW_MOUNT/agents/main/agent/auth-profiles.json"
          if [ ! -f "$auth_file" ]; then
            return 1
          fi
          grep -q "\"${PROVIDER_ID}:default\"" "$auth_file" 2>/dev/null
        }

        set_env_var "$ENV_VAR" "$API_KEY"

        should_onboard=0
        if ! provider_registered; then
          should_onboard=1
        fi

        if [ "$should_onboard" = 1 ]; then
          echo "Running onboard for $PROVIDER ($ONBOARD_AUTH)..."
        else
          echo "Provider $PROVIDER already registered; updating env key and default model (no onboard)."
        fi
        run_maintenance "$ONBOARD_AUTH" "$should_onboard"

        strip_onboard_vars
        normalize_env_file
        recreate_openclaw_container

        for i in $(seq 1 120); do
          if curl -fsS "http://127.0.0.1:$PUBLIC_PORT/" >/dev/null 2>&1; then
            break
          fi
          sleep 2
        done

        docker exec \
          -e TARGET_MODEL="$TARGET_MODEL" \
          openclaw sh -lc 'openclaw models set "$TARGET_MODEL"' || true

        docker exec openclaw sh -lc 'openclaw models status' || true
        rm -f "$MAINT_SCRIPT"

        oc_finish 0
        ) || true

        exit 0
    - script: |
        var resp = api.env.control.ExecCmdById(
          "${env.name}",
          session,
          ${targetNodes.master.id},
          toJSON([{ command: "cat /tmp/openclaw-configure.result 2>/dev/null || echo 99", params: "" }]),
          false,
          "root"
        );
        if (resp.result != 0) return resp;
        var out = (resp.responses && resp.responses[0]) ? String(resp.responses[0].out || "") : "";
        var code = parseInt(out.trim(), 10);
        if (isNaN(code)) code = 99;
        if (code === 0) {
          return {
            result: 200,
            type: "success",
            message: "Default model **${settings.model}** is configured for **${settings.provider}**."
          };
        }
        return { result: code, type: "warning" };
