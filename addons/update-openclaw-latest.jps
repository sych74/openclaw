type: update
id: update-openclaw-latest
name: Update OpenClaw
description: Install the supported OpenClaw CLI version inside the running container and restart the gateway.

targetNodes:
  nodeGroup: cp

globals:
  openclawVersion: 2026.8.33

buttons:
  - name: update
    caption: Update Now
    settings: main
    confirmText: Update OpenClaw to the supported version? The gateway container will be restarted.
    loadingText: Updating OpenClaw...
    action: update

settings:
  submitUnchanged: true

actions:
  update:
    - cmd[cp]: |-
        set -eu
        OPENCLAW_VERSION="${globals.openclawVersion}"
        OPENCLAW_MOUNT="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/home/node/.openclaw"}}{{.Source}}{{end}}{{end}}' openclaw)"
        if [ -n "$OPENCLAW_MOUNT" ] && [ -f "$OPENCLAW_MOUNT/start.sh" ]; then
          sed -i "s/^export OPENCLAW_VERSION=.*/export OPENCLAW_VERSION=\"$OPENCLAW_VERSION\"/" "$OPENCLAW_MOUNT/start.sh"
        fi
        if [ -f /root/openclaw.env ]; then
          sed -i "s/^OPENCLAW_VERSION=.*/OPENCLAW_VERSION=$OPENCLAW_VERSION/" /root/openclaw.env
        fi
        docker exec openclaw sh -lc "npm install -g openclaw@$OPENCLAW_VERSION"
        docker restart openclaw
        for i in $(seq 1 120); do
          if docker exec openclaw sh -lc 'openclaw --version' >/dev/null 2>&1; then
            break
          fi
          sleep 2
        done
        docker exec openclaw sh -lc 'openclaw --version' || true
