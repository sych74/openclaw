type: update
id: update-openclaw-latest
name: Update OpenClaw to Latest
description: Upgrade the OpenClaw CLI inside the running container and restart the gateway.

targetNodes:
  nodeGroup: cp

buttons:
  - name: update
    caption: Update Now
    settings: main
    confirmText: Update OpenClaw to the latest version? The gateway container will be restarted.
    loadingText: Updating OpenClaw...
    action: update

settings:
  submitUnchanged: true

actions:
  update:
    - cmd[cp]: |-
        set -eu
        docker exec openclaw sh -lc 'npm install -g openclaw@latest'
        docker restart openclaw
        for i in $(seq 1 120); do
          if docker exec openclaw sh -lc 'openclaw --version' >/dev/null 2>&1; then
            break
          fi
          sleep 2
        done
        docker exec openclaw sh -lc 'openclaw --version' || true
